# Postgres ulanish satri (Vercel-managed Neon integratsiyasi avtomatik
# beradi: `vercel env pull .env.local` bilan tortib olinadi). Lokal test
# uchun o'zingizning Neon loyihangizning connection string'ini qo'ying —
# namuna: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# JWT imzolash kalitlari — PRODUCTION'DA albatta tasodifiy qiymat bilan almashtiring.
# Generatsiya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
TELEGRAM_SESSION_SECRET=

# `npm run db:seed` ishga tushganda yaratiladigan admin login/parol.
# Bo'sh qoldirilsa standart qiymat ishlatiladi: admin / Aromato2026!
# PRODUCTION'DA albatta o'zingizning qiymatingizni kiriting.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=

# Telegram bot integratsiyasi (ixtiyoriy — bo'sh qoldirilsa, bot funksiyalari
# jim o'tkazib yuboriladi, sayt baribir to'liq ishlaydi).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Saytning ochiq (production) manzili. Telegram webhook faqat HTTPS bilan ishlaydi.
NEXT_PUBLIC_APP_URL=http://localhost:3000
